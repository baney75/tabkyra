+import type { AgentMessage } from "@mariozechner/pi-agent-core";
+import type { Attachment } from "./attachment-utils.js";
+
+export interface QueuedMessage {
+	id: number;
+	input: string;
+	attachments?: Attachment[];
+	/** Set once "Send now" handed it to the running agent; cleared if the run ends first. */
+	steered?: AgentMessage;
+}
+
+/** The parts of Agent the queue uses. */
+export interface QueueAgent {
+	state: { isStreaming: boolean };
+	steer(message: AgentMessage): void;
+	clearSteeringQueue(): void;
+}
+
+/**
+ * Messages the user sends while the agent runs. The list is the only queue: when a run ends
+ * normally the first item goes out through `send` as an ordinary prompt. "Send now" hands an
+ * item to the running agent with steer(), which delivers it after the current tool call; it
+ * leaves the list once the agent injects it. A stopped or failed run pauses the queue until
+ * the user presses Send now on an item; removing items never resumes it.
+ */
+export class MessageQueue {
+	items: QueuedMessage[] = [];
+	paused = false;
+	private seq = 0;
+	private draining = false;
+
+	constructor(
+		private readonly agent: () => QueueAgent | undefined,
+		private readonly send: (input: string, attachments?: Attachment[]) => void | Promise<void>,
+		private readonly changed: () => void,
+		private readonly retryMs = 25,
+	) {}
+
+	add(input: string, attachments?: Attachment[]): void {
+		this.items = [...this.items, { id: ++this.seq, input, attachments }];
+		this.changed();
+	}
+
+	/** The user message for an item, shaped as Agent.prompt() builds one. */
+	static message(item: QueuedMessage): AgentMessage {
+		if (item.attachments && item.attachments.length > 0) {
+			return {
+				role: "user-with-attachments",
+				content: item.input,
+				attachments: item.attachments,
+				timestamp: Date.now(),
+			} as unknown as AgentMessage;
+		}
+		return { role: "user", content: [{ type: "text", text: item.input }], timestamp: Date.now() } as AgentMessage;
+	}
+
+	/** Send an item now: into the running turn, or as the next prompt when nothing runs. */
+	sendNow(id: number): void {
+		const item = this.items.find((q) => q.id === id);
+		const agent = this.agent();
+		if (!item || item.steered || !agent) return;
+		if (agent.state.isStreaming) {
+			const message = MessageQueue.message(item);
+			agent.steer(message);
+			this.items = this.items.map((q) => (q.id === id ? { ...q, steered: message } : q));
+			this.changed();
+			return;
+		}
+		this.items = this.items.filter((q) => q.id !== id);
+		this.paused = false;
+		this.changed();
+		void this.send(item.input, item.attachments);
+	}
+
+	remove(id: number): void {
+		this.items = this.items.filter((q) => q.id !== id || q.steered);
+		if (this.items.length === 0) this.paused = false;
+		this.changed();
+	}
+
+	/** A message the agent injected: a steered item is now in the transcript. */
+	onMessageStart(message: AgentMessage): void {
+		if (!this.items.some((q) => q.steered === message)) return;
+		this.items = this.items.filter((q) => q.steered !== message);
+		this.changed();
+	}
+
+	/** The run is over; send the next item, or pause if the user stopped it or it failed. */
+	onAgentEnd(messages: AgentMessage[]): void {
+		// A steer that arrived after the last turn is never injected; it becomes a plain queued item.
+		this.agent()?.clearSteeringQueue();
+		if (this.items.some((q) => q.steered)) this.items = this.items.map((q) => ({ ...q, steered: undefined }));
+		const last = [...messages].reverse().find((m) => m.role === "assistant") as { stopReason?: string } | undefined;
+		if (last?.stopReason === "aborted" || last?.stopReason === "error") this.paused = true;
+		this.changed();
+		if (!this.paused) this.drainWhenIdle();
+	}
+
+	private drainWhenIdle(): void {
+		if (this.draining) return;
+		this.draining = true;
+		const attempt = (tries: number) => {
+			const agent = this.agent();
+			if (!agent || this.paused || this.items.length === 0) {
+				this.draining = false;
+				return;
+			}
+			// agent_end fires just before the agent clears isStreaming.
+			if (agent.state.isStreaming) {
+				if (tries > 0) setTimeout(() => attempt(tries - 1), this.retryMs);
+				else this.draining = false;
+				return;
+			}
+			this.draining = false;
+			const [next, ...rest] = this.items;
+			this.items = rest;
+			this.changed();
+			void this.send(next.input, next.attachments);
+		};
+		setTimeout(() => attempt(200), 0);
+	}
+}
