diff --git a/packages/web-ui/src/components/transcript-hook.ts b/packages/web-ui/src/components/transcript-hook.ts
new file mode 100644
index 000000000..0b51c2070
--- /dev/null
+++ b/packages/web-ui/src/components/transcript-hook.ts
@@ -0,0 +1,34 @@
+import type { AgentMessage, AgentTool } from "@mariozechner/pi-agent-core";
+import type { AssistantMessage, ToolResultMessage } from "@mariozechner/pi-ai";
+import type { TemplateResult } from "lit";
+
+export interface TranscriptContext {
+	tools: AgentTool[];
+	pendingToolCalls?: Set<string>;
+	toolResultsById: Map<string, ToolResultMessage>;
+	isStreaming: boolean;
+	onCostClick?: () => void;
+}
+
+/**
+ * An app-supplied transcript layout. `items` replaces MessageList's one-item-per-message
+ * rendering; `live` renders the assistant message still streaming. Either may return
+ * undefined to fall back to the built-in rendering.
+ */
+export interface TranscriptRenderer {
+	items(
+		messages: AgentMessage[],
+		ctx: TranscriptContext,
+	): Array<{ key: string; template: TemplateResult }> | undefined;
+	live?(message: AssistantMessage, ctx: TranscriptContext): TemplateResult | undefined;
+}
+
+let current: TranscriptRenderer | undefined;
+
+export function setTranscriptRenderer(renderer: TranscriptRenderer | undefined): void {
+	current = renderer;
+}
+
+export function getTranscriptRenderer(): TranscriptRenderer | undefined {
+	return current;
+}
