@@ -0,0 +1,138 @@
+import { DownloadButton } from "@mariozechner/mini-lit/dist/DownloadButton.js";
+import { html, type TemplateResult } from "lit";
+import { state } from "lit/decorators.js";
+import { createRef, type Ref, ref } from "lit/directives/ref.js";
+import { i18n } from "../../../utils/i18n.js";
+import { ArtifactElement } from "../ArtifactElement.js";
+import { decodeBase64Content } from "./content.js";
+import { mimeTypeFor } from "./file-types.js";
+
+/**
+ * Base for the document previews (pptx, ODF, RTF, notebooks, CSV, media). It holds the content,
+ * renders into a container on change, drops a render that a newer one replaced, and shows a
+ * readable error instead of a blank panel when a file can't be read.
+ */
+export abstract class PreviewArtifact extends ArtifactElement {
+	private _content = "";
+	private renderToken = 0;
+	private cleanup: (() => void) | undefined;
+	protected containerRef: Ref<HTMLDivElement> = createRef();
+	@state() protected error: string | null = null;
+	@state() protected loading = false;
+
+	get content(): string {
+		return this._content;
+	}
+
+	set content(value: string) {
+		if (value === this._content) return;
+		this._content = value;
+		this.error = null;
+		this.requestUpdate();
+		void this.refresh();
+	}
+
+	/** Content is base64 for binary formats; text formats override this. */
+	protected get isBinary(): boolean {
+		return true;
+	}
+
+	protected get errorTitle(): string {
+		return i18n("Error loading document");
+	}
+
+	/** Draw the preview into `container`. Return a cleanup function for object URLs and observers. */
+	protected abstract renderPreview(container: HTMLElement, content: string): Promise<(() => void) | undefined>;
+
+	protected override createRenderRoot(): HTMLElement | DocumentFragment {
+		return this;
+	}
+
+	override connectedCallback(): void {
+		super.connectedCallback();
+		this.style.display = "block";
+		this.style.height = "100%";
+	}
+
+	override disconnectedCallback(): void {
+		super.disconnectedCallback();
+		// Panel tabs detach and reattach their elements; keep the rendered preview.
+	}
+
+	private async refresh(): Promise<void> {
+		await this.updateComplete;
+		const container = this.containerRef.value;
+		if (!container || !this._content) return;
+		const token = ++this.renderToken;
+		this.cleanup?.();
+		this.cleanup = undefined;
+		// Each render draws into its own child, so a render that a newer one replaced can be
+		// removed whole even if it finishes later.
+		const target = container.ownerDocument.createElement("div");
+		target.className = "h-full";
+		container.replaceChildren(target);
+		this.loading = true;
+		try {
+			const cleanup = await this.renderPreview(target, this._content);
+			if (token !== this.renderToken) {
+				cleanup?.();
+				target.remove();
+				return;
+			}
+			this.cleanup = cleanup;
+		} catch (e) {
+			target.remove();
+			if (token !== this.renderToken) return;
+			this.error = e instanceof Error ? e.message : String(e);
+		} finally {
+			if (token === this.renderToken) this.loading = false;
+		}
+	}
+
+	private downloadCache?: { content: string; bytes: Uint8Array };
+
+	/** The file as saved. Not size-limited: download is the way out for files too large to preview. */
+	protected downloadBytes(): Uint8Array | string {
+		if (!this.isBinary) return this._content;
+		if (this.downloadCache?.content === this._content) return this.downloadCache.bytes;
+		try {
+			const bytes = decodeBase64Content(this._content, Number.POSITIVE_INFINITY);
+			this.downloadCache = { content: this._content, bytes };
+			return bytes;
+		} catch {
+			return this._content;
+		}
+	}
+
+	public getHeaderButtons(): TemplateResult {
+		return html`
+			<div class="flex items-center gap-1">
+				${DownloadButton({
+					content: this.downloadBytes(),
+					filename: this.filename,
+					mimeType: mimeTypeFor(this.filename),
+					title: i18n("Download"),
+				})}
+			</div>
+		`;
+	}
+
+	override render(): TemplateResult {
+		return html`
+			<div class="h-full flex flex-col bg-background overflow-auto relative">
+				${
+					this.error
+						? html`<div class="flex-1 flex items-center justify-center p-4">
+							<div class="bg-destructive/10 border border-destructive text-destructive p-4 rounded-lg max-w-2xl">
+								<div class="font-medium mb-1">${this.errorTitle}</div>
+								<div class="text-sm opacity-90">${this.error}</div>
+							</div>
+						</div>`
+						: ""
+				}
+				${this.loading ? html`<div class="absolute top-2 right-3 text-xs text-muted-foreground">${i18n("Loading...")}</div>` : ""}
+				<div ${ref(this.containerRef)} class="flex-1 min-h-0" style="display: ${this.error ? "none" : "block"}"></div>
+			</div>
+		`;
+	}
+}
diff --git a/packages/web-ui/src/tools/artifacts/preview/content.ts b/packages/web-ui/src/tools/artifacts/preview/content.ts
new file mode 100644
index 000000000..fb3797609
--- /dev/null
+++ b/packages/web-ui/src/tools/artifacts/preview/content.ts
@@ -0,0 +1,223 @@
+import JSZip from "jszip";
+
+/** Limits shared by the document previews. A file over a limit shows a message instead of a preview. */
+export const PREVIEW_LIMITS = {
+	/** Largest decoded file any parsing preview (pptx, odf, rtf, notebook, csv) reads. */
+	maxDocumentBytes: 40 * 1024 * 1024,
+	/** Largest media file played in the panel. */
+	maxMediaBytes: 200 * 1024 * 1024,
+	/** Largest single zip entry inflated (XML parts and images). */
+	maxZipEntryBytes: 30 * 1024 * 1024,
+	/** Total bytes inflated from one archive. */
+	maxZipTotalBytes: 120 * 1024 * 1024,
+	/** Most entries an archive may list. */
+	maxZipEntries: 10_000,
+	/** Most slides or pages rendered. */
+	maxSlides: 300,
+	/** Most table rows rendered for CSV, TSV and spreadsheets. */
+	maxTableRows: 5_000,
+	/** Most table columns rendered. */
+	maxTableColumns: 500,
+	/** Most table cells rendered in one table. */
+	maxTableCells: 200_000,
+	/** Most elements drawn across all slides of a deck. */
+	maxDeckElements: 50_000,
+	/** Most text runs in one document or deck. */
+	maxTextRuns: 200_000,
+	/** Most characters of text in one document. */
+	maxTextChars: 5_000_000,
+	/** Most notebook outputs rendered. */
+	maxOutputs: 5_000,
+	/** Most notebook cells rendered. */
+	maxCells: 2_000,
+};
+
+export class PreviewLimitError extends Error {}
+
+function stripDataUrl(content: string): string {
+	if (content.startsWith("data:")) {
+		const comma = content.indexOf(",");
+		return comma >= 0 ? content.slice(comma + 1) : "";
+	}
+	return content;
+}
+
+/** Decoded size of a base64 string, without decoding it. */
+export function base64DecodedSize(content: string): number {
+	const data = stripDataUrl(content).replace(/\s+/g, "");
+	const padding = data.endsWith("==") ? 2 : data.endsWith("=") ? 1 : 0;
+	return Math.max(0, Math.floor((data.length * 3) / 4) - padding);
+}
+
+/** Decode artifact content stored as base64 or a base64 data URL. Throws on anything else. */
+export function decodeBase64Content(content: string, maxBytes = PREVIEW_LIMITS.maxDocumentBytes): Uint8Array {
+	const data = stripDataUrl(content).replace(/\s+/g, "");
+	if (base64DecodedSize(data) > maxBytes) {
+		throw new PreviewLimitError(`File is larger than ${Math.round(maxBytes / (1024 * 1024))} MB`);
+	}
+	if (!/^[A-Za-z0-9+/_-]*={0,2}$/.test(data)) throw new Error("Content is not base64");
+	const binary = atob(data.replace(/-/g, "+").replace(/_/g, "/"));
+	const bytes = new Uint8Array(binary.length);
+	for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
+	return bytes;
+}
+
+/**
+ * Content of a text format (csv, rtf, ipynb). Agents usually store these as text, but a REPL
+ * may store them as base64; `looksRight` decides which reading is the file.
+ */
+export function readTextContent(content: string, looksRight: (text: string) => boolean): string {
+	if (looksRight(content)) return content;
+	try {
+		const decoded = new TextDecoder("utf-8", { fatal: false }).decode(decodeBase64Content(content));
+		if (looksRight(decoded)) return decoded;
+	} catch {
+		// Not base64; fall through to the raw text.
+	}
+	return content;
+}
+
+interface StreamHelper {
+	on(event: "data", cb: (chunk: Uint8Array) => void): StreamHelper;
+	on(event: "end", cb: () => void): StreamHelper;
+	on(event: "error", cb: (e: Error) => void): StreamHelper;
+	resume(): StreamHelper;
+	pause(): StreamHelper;
+}
+
+interface StreamableZipObject {
+	internalStream(type: "uint8array"): StreamHelper;
+}
+
+function isStreamable(file: unknown): file is StreamableZipObject {
+	return typeof (file as { internalStream?: unknown }).internalStream === "function";
+}
+
+/**
+ * Reads entries from an untrusted archive. Every entry is inflated through a stream that stops
+ * at the per-entry limit, and the archive as a whole has a byte budget, so a zip bomb fails
+ * fast instead of freezing the panel.
+ */
+export class SafeZip {
+	private used = 0;
+
+	private constructor(private readonly zip: JSZip) {}
+
+	static async open(bytes: Uint8Array): Promise<SafeZip> {
+		const zip = await JSZip.loadAsync(bytes);
+		if (Object.keys(zip.files).length > PREVIEW_LIMITS.maxZipEntries) {
+			throw new PreviewLimitError("Archive has too many entries to preview");
+		}
+		return new SafeZip(zip);
+	}
+
+	has(path: string): boolean {
+		const file = this.zip.file(path);
+		return !!file && !file.dir;
+	}
+
+	list(): string[] {
+		return Object.keys(this.zip.files).filter((p) => !this.zip.files[p].dir);
+	}
+
+	async bytes(path: string): Promise<Uint8Array | undefined> {
+		const file = this.zip.file(path);
+		if (!file || file.dir) return undefined;
+		const remaining = PREVIEW_LIMITS.maxZipTotalBytes - this.used;
+		const cap = Math.min(PREVIEW_LIMITS.maxZipEntryBytes, remaining);
+		// Fail fast on the size the archive declares; the capped stream below still guards
+		// against an archive that understates it.
+		const declared = declaredSize(file);
+		if (declared !== undefined && declared > cap)
+			throw new PreviewLimitError("A part of this file is too large to preview");
+		const data = await readCapped(file, cap);
+		this.used += data.length;
+		return data;
+	}
+
+	async text(path: string): Promise<string | undefined> {
+		const data = await this.bytes(path);
+		return data ? new TextDecoder("utf-8").decode(data) : undefined;
+	}
+}
+
+/** Uncompressed size from the zip directory. JSZip keeps it on a private field. */
+function declaredSize(file: JSZip.JSZipObject): number | undefined {
+	const size = (file as unknown as { _data?: { uncompressedSize?: unknown } })._data?.uncompressedSize;
+	return typeof size === "number" && size >= 0 ? size : undefined;
+}
+
+function readCapped(file: JSZip.JSZipObject, cap: number): Promise<Uint8Array> {
+	if (!isStreamable(file)) {
+		return file.async("uint8array").then((data) => {
+			if (data.length > cap) throw new PreviewLimitError("A part of this file is too large to preview");
+			return data;
+		});
+	}
+	return new Promise((resolve, reject) => {
+		const chunks: Uint8Array[] = [];
+		let total = 0;
+		let done = false;
+		const stream = file.internalStream("uint8array");
+		stream
+			.on("data", (chunk) => {
+				if (done) return;
+				total += chunk.length;
+				if (total > cap) {
+					done = true;
+					stream.pause();
+					reject(new PreviewLimitError("A part of this file is too large to preview"));
+					return;
+				}
+				chunks.push(chunk);
+			})
+			.on("error", (e) => {
+				if (done) return;
+				done = true;
+				reject(e);
+			})
+			.on("end", () => {
+				if (done) return;
+				done = true;
+				const out = new Uint8Array(total);
+				let offset = 0;
+				for (const c of chunks) {
+					out.set(c, offset);
+					offset += c.length;
+				}
+				resolve(out);
+			})
+			.resume();
+	});
+}
+
+/** Resolve a relationship target against the folder of the part that names it. */
+export function resolvePartPath(baseDir: string, target: string): string {
+	if (target.startsWith("/")) return target.slice(1);
+	const parts = baseDir ? baseDir.split("/") : [];
+	for (const seg of target.split("/")) {
+		if (seg === "..") parts.pop();
+		else if (seg !== "." && seg !== "") parts.push(seg);
+	}
+	return parts.join("/");
+}
+
+const IMAGE_MIME: Record<string, string> = {
+	png: "image/png",
+	jpg: "image/jpeg",
+	jpeg: "image/jpeg",
+	jpe: "image/jpeg",
+	jfif: "image/jpeg",
+	gif: "image/gif",
+	bmp: "image/bmp",
+	webp: "image/webp",
+	avif: "image/avif",
+	svg: "image/svg+xml",
+	ico: "image/x-icon",
+};
+
+/** MIME type for an embedded image the browser can decode, or undefined (EMF, WMF, TIFF, ...). */
+export function browserImageMime(path: string): string | undefined {
+	const ext = path.split(".").pop()?.toLowerCase() ?? "";
+	return IMAGE_MIME[ext];
+}
