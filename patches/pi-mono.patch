@@ -0,0 +1,73 @@
+import { customElement } from "lit/decorators.js";
+import { i18n } from "../../utils/i18n.js";
+import { decodeBase64Content, PREVIEW_LIMITS } from "./preview/content.js";
+import { getArtifactFileType, mimeTypeFor } from "./preview/file-types.js";
+import { PreviewArtifact } from "./preview/PreviewArtifact.js";
+
+/** Audio and video with the browser's own player. The file plays from a local blob URL. */
+@customElement("media-artifact")
+export class MediaArtifact extends PreviewArtifact {
+	private media?: HTMLMediaElement;
+
+	override disconnectedCallback(): void {
+		super.disconnectedCallback();
+		this.media?.pause();
+	}
+
+	protected override get errorTitle(): string {
+		return i18n("Error loading media");
+	}
+
+	protected async renderPreview(container: HTMLElement, content: string) {
+		const bytes = decodeBase64Content(content, PREVIEW_LIMITS.maxMediaBytes);
+		const copy = new Uint8Array(bytes.length);
+		copy.set(bytes);
+		const url = URL.createObjectURL(new Blob([copy.buffer], { type: mimeTypeFor(this.filename) }));
+		const isVideo = getArtifactFileType(this.filename) === "video";
+		const doc = container.ownerDocument;
+		const wrap = doc.createElement("div");
+		wrap.className = "h-full flex flex-col items-center justify-center gap-3 p-4";
+		const media = doc.createElement(isVideo ? "video" : "audio");
+		media.controls = true;
+		media.preload = "metadata";
+		media.src = url;
+		media.setAttribute("controlsList", "nodownload");
+		if (media instanceof HTMLVideoElement) {
+			media.className = "max-w-full max-h-full rounded bg-black";
+			media.playsInline = true;
+		} else {
+			media.className = "w-full max-w-xl";
+		}
+		const name = doc.createElement("div");
+		name.className = "text-sm text-muted-foreground break-all text-center";
+		name.textContent = this.filename;
+		media.addEventListener("error", () => {
+			name.textContent = i18n("This browser can't play {filename}. Download it to play it elsewhere.").replace(
+				"{filename}",
+				this.filename,
+			);
+		});
+		wrap.append(media, name);
+		container.appendChild(wrap);
+		this.media = media;
+		// Hidden tabs stay in the DOM with display: none; stop playback when this one is hidden.
+		const observer = new IntersectionObserver((entries) => {
+			if (entries.some((e) => !e.isIntersecting)) media.pause();
+		});
+		observer.observe(media);
+		return () => {
+			observer.disconnect();
+			this.media = undefined;
+			media.pause();
+			media.removeAttribute("src");
+			media.load();
+			URL.revokeObjectURL(url);
+		};
+	}
+}
+
+declare global {
+	interface HTMLElementTagNameMap {
+		"media-artifact": MediaArtifact;
+	}
+}
diff --git a/packages/web-ui/src/tools/artifacts/NotebookArtifact.ts b/packages/web-ui/src/tools/artifacts/NotebookArtifact.ts
new file mode 100644
index 000000000..41d9aecca
--- /dev/null
+++ b/packages/web-ui/src/tools/artifacts/NotebookArtifact.ts
@@ -0,0 +1,164 @@
+import hljs from "highlight.js";
+import { customElement } from "lit/decorators.js";
+import { marked } from "marked";
+import { i18n } from "../../utils/i18n.js";
+import { PREVIEW_LIMITS, PreviewLimitError, readTextContent } from "./preview/content.js";
+import { looksLikeNotebook, type NotebookOutput, neutralizeRemoteImages, parseNotebook } from "./preview/notebook.js";
+import { PreviewArtifact } from "./preview/PreviewArtifact.js";
+import { sanitizeHtml } from "./preview/sanitize.js";
+
+const MAX_OUTPUT_CHARS = 200_000;
+
+/**
+ * Notebook markdown is untrusted: render it with marked to a string, then rebuild it through the
+ * allow-list sanitizer, which keeps only inline data: images and drops raw HTML that could load
+ * anything. Safety never depends on predicting how marked tokenizes code spans.
+ */
+function renderMarkdown(doc: Document, source: string, attachments: Record<string, string>): HTMLElement {
+	const div = doc.createElement("div");
+	div.className =
+		"markdown-content text-foreground break-words [&_h1]:text-2xl [&_h1]:font-bold [&_h1]:my-2 [&_h2]:text-xl [&_h2]:font-bold [&_h2]:my-2 [&_h3]:text-lg [&_h3]:font-semibold [&_h3]:my-1 [&_p]:my-1 [&_ul]:list-disc [&_ul]:pl-6 [&_ol]:list-decimal [&_ol]:pl-6 [&_pre]:p-2 [&_pre]:bg-muted/50 [&_pre]:rounded [&_pre]:overflow-x-auto [&_code]:font-mono [&_code]:text-xs [&_a]:underline [&_blockquote]:border-l-2 [&_blockquote]:pl-3 [&_blockquote]:text-muted-foreground [&_table]:border-collapse [&_td]:border [&_td]:px-2 [&_th]:border [&_th]:px-2 [&_img]:max-w-full";
+	const html = marked.parse(clip(neutralizeRemoteImages(source, attachments)), { async: false, gfm: true }) as string;
+	div.appendChild(sanitizeHtml(html, doc));
+	return div;
+}
+
+function clip(text: string): string {
+	return text.length > MAX_OUTPUT_CHARS
+		? `${text.slice(0, MAX_OUTPUT_CHARS)}\n[${i18n("Truncated for display")}]`
+		: text;
+}
+
+/**
+ * Jupyter notebooks: markdown cells, code cells and their saved outputs. Nothing is executed.
+ * HTML outputs pass an allow-list sanitizer; images show only from inline data.
+ */
+@customElement("notebook-artifact")
+export class NotebookArtifact extends PreviewArtifact {
+	protected override get isBinary(): boolean {
+		return false;
+	}
+
+	protected override get errorTitle(): string {
+		return i18n("Error loading notebook");
+	}
+
+	protected async renderPreview(container: HTMLElement, content: string) {
+		const text = readTextContent(content, looksLikeNotebook);
+		if (text.length > PREVIEW_LIMITS.maxDocumentBytes) throw new PreviewLimitError("File is too large to preview");
+		const nb = parseNotebook(text, PREVIEW_LIMITS.maxCells);
+		const doc = container.ownerDocument;
+		const urls: string[] = [];
+		const root = doc.createElement("div");
+		root.className = "h-full overflow-auto p-3 flex flex-col gap-3 text-sm";
+		if (nb.truncated) {
+			const note = doc.createElement("div");
+			note.className = "text-xs text-muted-foreground";
+			note.textContent = i18n("Truncated for display");
+			root.appendChild(note);
+		}
+		if (nb.cells.length < nb.totalCells) {
+			const note = doc.createElement("div");
+			note.className = "text-xs text-muted-foreground";
+			note.textContent = i18n("showing the first {count}").replace("{count}", String(nb.cells.length));
+			root.appendChild(note);
+		}
+		for (const cell of nb.cells) {
+			const cellEl = doc.createElement("div");
+			cellEl.className = "flex flex-col gap-1 min-w-0";
+			if (cell.type === "markdown") {
+				const md = renderMarkdown(doc, cell.source, cell.attachments);
+				cellEl.appendChild(md);
+			} else if (cell.type === "code") {
+				const label = doc.createElement("div");
+				label.className = "text-xs font-mono text-muted-foreground";
+				label.textContent = `In [${cell.executionCount ?? " "}]:`;
+				const pre = doc.createElement("pre");
+				pre.className = "m-0 p-2 rounded border border-border bg-muted/50 overflow-x-auto text-xs";
+				const code = doc.createElement("code");
+				code.className = "hljs";
+				const source = clip(cell.source);
+				if (hljs.getLanguage(nb.language)) {
+					// highlight.js escapes the source; its output holds only its own spans.
+					code.innerHTML = hljs.highlight(source, { language: nb.language, ignoreIllegals: true }).value;
+				} else {
+					code.textContent = source;
+				}
+				pre.appendChild(code);
+				cellEl.append(label, pre);
+				for (const out of cell.outputs) {
+					const o = this.renderOutput(doc, out, urls);
+					if (o) cellEl.appendChild(o);
+				}
+			} else {
+				const pre = doc.createElement("pre");
+				pre.className = "m-0 p-2 text-xs text-muted-foreground whitespace-pre-wrap";
+				pre.textContent = clip(cell.source);
+				cellEl.appendChild(pre);
+			}
+			root.appendChild(cellEl);
+		}
+		if (nb.cells.length === 0) {
+			root.textContent = i18n("This notebook has no cells.");
+		}
+		container.appendChild(root);
+		return () => {
+			for (const u of urls) URL.revokeObjectURL(u);
+		};
+	}
+
+	private renderOutput(doc: Document, out: NotebookOutput, urls: string[]): HTMLElement | undefined {
+		const box = doc.createElement("div");
+		box.className = "pl-2 border-l-2 border-border min-w-0 overflow-x-auto";
+		switch (out.kind) {
+			case "stream":
+			case "text":
+			case "error": {
+				const pre = doc.createElement("pre");
+				pre.className = `m-0 text-xs whitespace-pre-wrap ${out.kind === "error" || (out.kind === "stream" && out.name === "stderr") ? "text-destructive" : ""}`;
+				pre.textContent = clip(out.text);
+				box.appendChild(pre);
+				break;
+			}
+			case "image": {
+				const img = doc.createElement("img");
+				img.src = `data:${out.mime};base64,${out.data}`;
+				img.alt = "";
+				img.className = "max-w-full h-auto bg-white";
+				box.appendChild(img);
+				break;
+			}
+			case "svg": {
+				// As an <img>, an SVG cannot run script or load anything else.
+				const url = URL.createObjectURL(new Blob([out.svg], { type: "image/svg+xml" }));
+				urls.push(url);
+				const img = doc.createElement("img");
+				img.src = url;
+				img.alt = "";
+				img.className = "max-w-full h-auto bg-white";
+				box.appendChild(img);
+				break;
+			}
+			case "html": {
+				const div = doc.createElement("div");
+				div.className =
+					"notebook-html text-xs [&_table]:border-collapse [&_td]:border [&_td]:border-border [&_td]:px-2 [&_td]:py-1 [&_th]:border [&_th]:border-border [&_th]:px-2 [&_th]:py-1 [&_th]:bg-muted";
+				div.appendChild(sanitizeHtml(out.html, doc));
+				box.appendChild(div);
+				break;
+			}
+			case "markdown": {
+				const md = renderMarkdown(doc, out.text, {});
+				box.appendChild(md);
+				break;
+			}
+		}
+		return box;
+	}
+}
+
+declare global {
+	interface HTMLElementTagNameMap {
+		"notebook-artifact": NotebookArtifact;
+	}
+}
diff --git a/packages/web-ui/src/tools/artifacts/OdfArtifact.ts b/packages/web-ui/src/tools/artifacts/OdfArtifact.ts
new file mode 100644
index 000000000..5a6b9fef7
--- /dev/null
+++ b/packages/web-ui/src/tools/artifacts/OdfArtifact.ts
@@ -0,0 +1,152 @@
+import { customElement } from "lit/decorators.js";
+import { i18n } from "../../utils/i18n.js";
+import { decodeBase64Content } from "./preview/content.js";
+import { mountDeck } from "./preview/deck-view.js";
+import { getArtifactFileType } from "./preview/file-types.js";
+import { type OdfRun, type OdtBlock, type OdtParagraph, readOdp, readOdt } from "./preview/odf.js";
+import { PreviewArtifact } from "./preview/PreviewArtifact.js";
+import { documentPage } from "./preview/page.js";
+import { fontFamily, imageUrls } from "./preview/slide-render.js";
+
+const PX_PER_PT = 96 / 72;
+const EMU_PER_PX = 9525;
+const HEADING_SIZE = [0, 2, 1.5, 1.25, 1.1, 1, 0.9];
+
+/** OpenDocument text (.odt) as a page, and presentations (.odp) as slides. */
+@customElement("odf-artifact")
+export class OdfArtifact extends PreviewArtifact {
+	protected override get errorTitle(): string {
+		return getArtifactFileType(this.filename) === "odp"
+			? i18n("Error loading presentation")
+			: i18n("Error loading document");
+	}
+
+	protected async renderPreview(container: HTMLElement, content: string) {
+		const bytes = decodeBase64Content(content);
+		if (getArtifactFileType(this.filename) === "odp") return mountDeck(container, await readOdp(bytes));
+
+		const odt = await readOdt(bytes);
+		const doc = container.ownerDocument;
+		const { urls, revoke } = imageUrls(odt);
+		const { scroller, page } = documentPage(doc);
+		for (const b of odt.blocks) page.appendChild(renderBlock(doc, b, urls));
+		if (odt.truncated) {
+			const note = doc.createElement("p");
+			note.style.color = "#777";
+			note.textContent = `[${i18n("Truncated for display")}]`;
+			page.appendChild(note);
+		}
+		container.appendChild(scroller);
+		return revoke;
+	}
+}
+
+function renderRun(doc: Document, run: OdfRun, urls: Map<string, string>): Node {
+	if ("br" in run) return doc.createElement("br");
+	if ("image" in run) {
+		const url = urls.get(run.image);
+		if (!url) return doc.createTextNode("[Image]");
+		const img = doc.createElement("img");
+		img.src = url;
+		img.alt = "";
+		img.style.maxWidth = "100%";
+		img.style.display = "inline-block";
+		if (run.width) img.style.width = `${run.width * PX_PER_PT}px`;
+		return img;
+	}
+	const el = doc.createElement(run.href ? "a" : "span");
+	el.textContent = run.text;
+	if (run.href && el instanceof HTMLAnchorElement) {
+		el.href = run.href;
+		el.target = "_blank";
+		el.rel = "noopener noreferrer";
+	}
+	const s = run.style;
+	if (s.size) el.style.fontSize = `${s.size * PX_PER_PT}px`;
+	if (s.font) el.style.fontFamily = fontFamily(s.font);
+	if (s.bold) el.style.fontWeight = "700";
+	if (s.italic) el.style.fontStyle = "italic";
+	const deco = [s.underline ? "underline" : "", s.strike ? "line-through" : ""].filter(Boolean).join(" ");
+	if (deco) el.style.textDecoration = deco;
+	if (s.color) el.style.color = s.color;
+	if (s.highlight) el.style.background = s.highlight;
+	if (s.baseline) {
+		el.style.verticalAlign = s.baseline > 0 ? "super" : "sub";
+		el.style.fontSize = `${(s.size ?? 12) * PX_PER_PT * 0.7}px`;
+	}
+	if (s.caps === "all") el.style.textTransform = "uppercase";
+	if (s.caps === "small") el.style.fontVariant = "small-caps";
+	return el;
+}
+
+function renderParagraph(doc: Document, p: OdtParagraph, urls: Map<string, string>): HTMLElement {
+	const el = doc.createElement(p.heading ? (`h${p.heading}` as "h1") : "p");
+	const s = p.style;
+	el.style.margin = "0";
+	el.style.whiteSpace = "pre-wrap";
+	el.style.minHeight = "1.2em";
+	if (p.heading) {
+		el.style.fontWeight = "700";
+		if (!s.run.size || s.run.size <= 12) el.style.fontSize = `${HEADING_SIZE[p.heading]}em`;
+	}
+	if (s.align) el.style.textAlign = { l: "left", ctr: "center", r: "right", just: "justify" }[s.align] ?? "left";
+	if (s.marL) el.style.paddingLeft = `${s.marL / EMU_PER_PX}px`;
+	if (s.indent) el.style.textIndent = `${s.indent / EMU_PER_PX}px`;
+	el.style.paddingTop = `${(s.spaceBefore ?? 0) * PX_PER_PT}px`;
+	el.style.paddingBottom = `${(s.spaceAfter ?? 4) * PX_PER_PT}px`;
+	if (s.lineSpacing) el.style.lineHeight = String(1.2 * s.lineSpacing);
+	if (p.background) el.style.background = p.background;
+	for (const r of p.runs) el.appendChild(renderRun(doc, r, urls));
+	return el;
+}
+
+function renderBlock(doc: Document, b: OdtBlock, urls: Map<string, string>): HTMLElement {
+	if (b.kind === "para") return renderParagraph(doc, b, urls);
+	if (b.kind === "list") {
+		const list = doc.createElement(b.ordered ? "ol" : "ul");
+		list.style.margin = "0 0 4px 0";
+		list.style.paddingLeft = "1.6em";
+		list.style.listStyleType = b.ordered ? "decimal" : "disc";
+		if (b.ordered && b.start !== 1) (list as HTMLOListElement).start = b.start;
+		for (const item of b.items) {
+			const li = doc.createElement("li");
+			for (const child of item) li.appendChild(renderBlock(doc, child, urls));
+			list.appendChild(li);
+		}
+		return list;
+	}
+	const table = doc.createElement("table");
+	table.style.borderCollapse = "collapse";
+	table.style.margin = "6px 0";
+	if (b.columns.some((c) => c)) {
+		const cg = doc.createElement("colgroup");
+		for (const c of b.columns) {
+			const col = doc.createElement("col");
+			if (c) col.style.width = `${c * PX_PER_PT}px`;
+			cg.appendChild(col);
+		}
+		table.appendChild(cg);
+	}
+	for (const row of b.rows) {
+		const tr = doc.createElement("tr");
+		for (const cell of row.cells) {
+			const td = doc.createElement("td");
+			if (cell.colSpan > 1) td.colSpan = cell.colSpan;
+			if (cell.rowSpan > 1) td.rowSpan = cell.rowSpan;
+			td.style.border = "1px solid #999";
+			td.style.padding = "2px 6px";
+			td.style.verticalAlign = "top";
+			if (cell.background) td.style.background = cell.background;
+			for (const child of cell.blocks) td.appendChild(renderBlock(doc, child, urls));
+			tr.appendChild(td);
+		}
+		table.appendChild(tr);
+	}
+	return table;
+}
+
+declare global {
+	interface HTMLElementTagNameMap {
+		"odf-artifact": OdfArtifact;
+	}
+}
diff --git a/packages/web-ui/src/tools/artifacts/PptxArtifact.ts b/packages/web-ui/src/tools/artifacts/PptxArtifact.ts
