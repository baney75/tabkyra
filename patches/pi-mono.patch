+					}
+					break;
+				case "pict":
+					st.dest = "pict";
+					pict = { hex: "", sx: 100, sy: 100 };
+					break;
+				case "pngblip":
+					if (pict) pict.type = "image/png";
+					break;
+				case "jpegblip":
+					if (pict) pict.type = "image/jpeg";
+					break;
+				case "picwgoal":
+					if (pict) pict.w = param;
+					break;
+				case "pichgoal":
+					if (pict) pict.h = param;
+					break;
+				case "picscalex":
+					if (pict) pict.sx = param ?? 100;
+					break;
+				case "picscaley":
+					if (pict) pict.sy = param ?? 100;
+					break;
+				case "fldinst":
+					st.dest = "skip";
+					break;
+				case "fldrslt":
+				case "shppict":
+				case "result":
+					if (st.dest !== "skip") st.dest = "body";
+					break;
+				case "par":
+					endParagraph();
+					break;
+				case "sect":
+				case "page":
+					endParagraph(false);
+					break;
+				case "line":
+					flushText();
+					if (st.dest === "body") runs.push({ br: true });
+					break;
+				case "pard":
+					st.para = { ...defaultPara() };
+					break;
+				case "plain":
+					st.char = defaultChar();
+					st.char.font = defaultFont;
+					break;
+				case "b":
+					st.char.bold = param !== 0;
+					break;
+				case "i":
+					st.char.italic = param !== 0;
+					break;
+				case "ul":
+				case "uld":
+				case "uldb":
+				case "ulw":
+				case "ulth":
+				case "uldash":
+				case "ulwave":
+					st.char.underline = param !== 0;
+					break;
+				case "ulnone":
+					st.char.underline = false;
+					break;
+				case "strike":
+				case "striked":
+					st.char.strike = param !== 0;
+					break;
+				case "fs":
+					if (param) st.char.size = param / 2;
+					break;
+				case "cf":
+					st.char.color = param;
+					break;
+				case "cb":
+				case "highlight":
+					st.char.background = param || undefined;
+					break;
+				case "super":
+					st.char.script = "super";
+					break;
+				case "sub":
+					st.char.script = "sub";
+					break;
+				case "nosupersub":
+					st.char.script = undefined;
+					break;
+				case "caps":
+					st.char.caps = param === 0 ? undefined : "all";
+					break;
+				case "scaps":
+					st.char.caps = param === 0 ? undefined : "small";
+					break;
+				case "v":
+					st.char.hidden = param !== 0;
+					break;
+				case "ql":
+					st.para.align = "left";
+					break;
+				case "qc":
+					st.para.align = "center";
+					break;
+				case "qr":
+					st.para.align = "right";
+					break;
+				case "qj":
+				case "qd":
+					st.para.align = "justify";
+					break;
+				case "li":
+					st.para.indentLeft = param ?? 0;
+					break;
+				case "ri":
+					st.para.indentRight = param ?? 0;
+					break;
+				case "fi":
+					st.para.firstLine = param ?? 0;
+					break;
+				case "sb":
+					st.para.spaceBefore = param ?? 0;
+					break;
+				case "sa":
+					st.para.spaceAfter = param ?? 0;
+					break;
+				case "intbl":
+					st.para.inTable = true;
+					break;
+				case "cell":
+				case "nestcell":
+					endParagraph(false);
+					row.push(cell);
+					cell = [];
+					break;
+				case "row":
+				case "nestrow":
+					if (cell.length) row.push(cell);
+					tableRows.push(row);
+					row = [];
+					cell = [];
+					break;
+				case "uc":
+					st.uc = param ?? 1;
+					break;
+				case "u": {
+					flushBytes();
+					let code = param ?? 0;
+					if (code < 0) code += 65536;
+					addText(String.fromCharCode(code));
+					skipChars = st.uc;
+					break;
+				}
+				default:
+					if (SYMBOLS[word] !== undefined) addText(SYMBOLS[word]);
+					else if (SKIP_DESTINATIONS.has(word)) st.dest = "skip";
+			}
+			continue;
+		}
+		if (ch === "\r" || ch === "\n") {
+			i++;
+			continue;
+		}
+		// Plain text
+		let j = i;
+		while (
+			j < n &&
+			source[j] !== "\\" &&
+			source[j] !== "{" &&
+			source[j] !== "}" &&
+			source[j] !== "\r" &&
+			source[j] !== "\n"
+		)
+			j++;
+		let chunk = source.slice(i, j);
+		i = j;
+		if (skipChars > 0) {
+			const drop = Math.min(skipChars, chunk.length);
+			chunk = chunk.slice(drop);
+			skipChars -= drop;
+		}
+		if (!chunk) continue;
+		if (st.dest === "colortbl") {
+			for (const c of chunk) {
+				if (c === ";") {
+					const { r, g, b } = colorParts;
+					colors.push(
+						colorSeen
+							? `#${[r ?? 0, g ?? 0, b ?? 0].map((v) => Math.max(0, Math.min(255, v)).toString(16).padStart(2, "0")).join("")}`
+							: undefined,
+					);
+					colorParts = {};
+					colorSeen = false;
+				}
+			}
+		} else if (st.dest === "pict" && pict) {
+			if (pict.hex.length < 60_000_000) pict.hex += chunk;
+		} else {
+			addText(chunk);
+		}
+	}
+	flushText();
+	if (runs.length) endParagraph();
+	if (tableRows.length || row.length || cell.length) endTable();
+	return { blocks, truncated };
+}
