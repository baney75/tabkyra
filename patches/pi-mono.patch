+					const h = pict.h ? (pict.h / 20) * (pict.sy / 100) : undefined;
+					runs.push({ image: `data:${pict.type};base64,${hexToBase64(pict.hex)}`, width: w, height: h });
+				}
+				pict = undefined;
+			}
