diff --git a/packages/web-ui/src/utils/message-queue.ts b/packages/web-ui/src/utils/message-queue.ts
new file mode 100644
index 000000000..29a072064
--- /dev/null
+++ b/packages/web-ui/src/utils/message-queue.ts
@@ -0,0 +1,158 @@
+import type { AgentMessage } from "@mariozechner/pi-agent-core";
+import type { Attachment } from "./attachment-utils.js";
+
+export interface QueuedMessage {
+	id: number;
+	input: string;
+	attachments?: Attachment[];
+	/** Set once "Send now" handed it to the running agent; cleared if the run ends first. */
+	steered?: AgentMessage;
+}
+
+/** The parts of Agent the queue uses. */
+export interface QueueAgent {
+	state: { isStreaming: boolean };
+	steer(message: AgentMessage): void;
+	clearSteeringQueue(): void;
+	waitForIdle(): Promise<void>;
+}
+
+/**
+ * How a send went. "started": a prompt is running. "busy": another send or run got there
+ * first, so the item waits for the next run's end. "refused": it can't go (no key, no model),
+ * so the queue pauses with the item back on top.
+ */
+export type SendResult = "started" | "busy" | "refused";
+
+/**
+ * Messages the user sends while the agent runs, for one agent. The list is the only queue:
+ * when a run ends normally the first item goes out through `send` as an ordinary prompt.
+ * "Send now" during a run hands the item (after any `beforeSteer` context) to the agent with
+ * steer(), which delivers it after the current tool call; it leaves the list once the agent
+ * injects it, and if the run ends first it goes out ahead of the rest. Send now with nothing
+ * running sends the item next. A stopped or failed run pauses the queue until the user presses
+ * Send now; removing items never resumes it.
+ */
+export class MessageQueue {
+	items: QueuedMessage[] = [];
+	paused = false;
+	private running: boolean;
+	private seq = 0;
+	private draining = false;
+
+	constructor(
+		readonly agent: QueueAgent,
+		private readonly send: (item: QueuedMessage) => Promise<SendResult>,
+		private readonly changed: () => void,
+		private readonly beforeSteer?: () => Promise<AgentMessage[]>,
+	) {
+		this.running = agent.state.isStreaming;
+	}
+
+	add(input: string, attachments?: Attachment[]): void {
+		this.items = [...this.items, { id: ++this.seq, input, attachments }];
+		this.changed();
+	}
+
+	/** The user message for an item, shaped as Agent.prompt() builds one. */
+	static message(item: QueuedMessage): AgentMessage {
+		if (item.attachments && item.attachments.length > 0) {
+			return {
+				role: "user-with-attachments",
+				content: item.input,
+				attachments: item.attachments,
+				timestamp: Date.now(),
+			} as unknown as AgentMessage;
+		}
+		return { role: "user", content: [{ type: "text", text: item.input }], timestamp: Date.now() } as AgentMessage;
+	}
+
+	/** Send an item now: into the running turn, or next when nothing runs. Always resumes. */
+	async sendNow(id: number): Promise<void> {
+		const pending = (q: QueuedMessage) => q.id === id && !q.steered;
+		if (!this.items.some(pending)) return;
+		this.paused = false;
+		if (this.running) {
+			const context = (await this.beforeSteer?.().catch(() => [])) ?? [];
+			const item = this.items.find(pending);
+			if (!item) return;
+			if (this.running) {
+				const message = MessageQueue.message(item);
+				for (const extra of context) this.agent.steer(extra);
+				this.agent.steer(message);
+				this.items = this.items.map((q) => (q.id === id ? { ...q, steered: message } : q));
+				this.changed();
+				return;
+			}
+		}
+		const item = this.items.find(pending);
+		if (!item) return;
+		this.items = [item, ...this.items.filter((q) => q.id !== id)];
+		this.changed();
+		void this.drain();
+	}
+
+	remove(id: number): void {
+		this.items = this.items.filter((q) => q.id !== id || q.steered);
+		if (this.items.length === 0) this.paused = false;
+		this.changed();
+	}
+
+	onAgentStart(): void {
+		this.running = true;
+	}
+
+	/** A message the agent injected: a steered item is now in the transcript. */
+	onMessageStart(message: AgentMessage): void {
+		if (!this.items.some((q) => q.steered === message)) return;
+		this.items = this.items.filter((q) => q.steered !== message);
+		this.changed();
+	}
+
+	/** The run is over; send the next item, or pause if the user stopped it or it failed. */
+	onAgentEnd(messages: AgentMessage[]): void {
+		this.running = false;
+		// A steer that arrived after the last turn is never injected. It was asked for first, so
+		// it goes out first.
+		this.agent.clearSteeringQueue();
+		const unpicked = this.items.filter((q) => q.steered).map((q) => ({ ...q, steered: undefined }));
+		if (unpicked.length > 0) this.items = [...unpicked, ...this.items.filter((q) => !q.steered)];
+		const last = [...messages].reverse().find((m) => m.role === "assistant") as { stopReason?: string } | undefined;
+		if (last?.stopReason === "aborted" || last?.stopReason === "error") this.paused = true;
+		this.changed();
+		void this.drain();
+	}
+
+	/** Forget everything (the panel switched to another session). */
+	dispose(): void {
+		this.agent.clearSteeringQueue();
+		this.items = [];
+		this.paused = false;
+	}
+
+	/** Once the agent is idle, send the first item; the next waits for that run's end. */
+	private async drain(): Promise<void> {
+		if (this.draining) return;
+		this.draining = true;
+		try {
+			await this.agent.waitForIdle();
+			if (this.paused || this.running || this.items.length === 0) return;
+			const [next, ...rest] = this.items;
+			this.items = rest;
+			this.changed();
+			let result: SendResult;
+			try {
+				result = await this.send(next);
+			} catch {
+				result = "refused";
+			}
+			if (result !== "started") {
+				this.items = [next, ...this.items];
+				if (result === "refused") this.paused = true;
+				this.changed();
+			}
+		} finally {
+			this.draining = false;
+		}
+	}
+}
