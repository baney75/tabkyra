+/**
+ * RTF reading for the preview: paragraphs with basic character and paragraph formatting,
+ * simple tables and embedded PNG/JPEG pictures. Fields show their result, objects show their
+ * picture, and everything else that is not body text (headers, metadata, style tables) is
+ * skipped. Pure: no DOM.
+ */
+
+export interface RtfRunStyle {
+	bold?: boolean;
+	italic?: boolean;
+	underline?: boolean;
+	strike?: boolean;
+	/** Points. */
+	size?: number;
+	color?: string;
+	background?: string;
+	font?: string;
+	script?: "super" | "sub";
+	caps?: "all" | "small";
+}
+
+export type RtfRun =
+	| { text: string; style: RtfRunStyle }
+	| { image: string; width?: number; height?: number }
+	| { br: true };
+
+export interface RtfParagraph {
+	kind: "para";
+	align?: "left" | "center" | "right" | "justify";
+	/** Points. */
+	indentLeft?: number;
+	indentRight?: number;
+	firstLine?: number;
+	spaceBefore?: number;
+	spaceAfter?: number;
+	runs: RtfRun[];
+}
+
+export interface RtfTable {
+	kind: "table";
+	rows: RtfParagraph[][][];
+}
+
+export type RtfBlock = RtfParagraph | RtfTable;
+
+export interface RtfDocument {
+	blocks: RtfBlock[];
+	truncated: boolean;
+}
+
+export const MAX_RTF_BLOCKS = 20_000;
+export const MAX_RTF_RUNS = 200_000;
+export const MAX_RTF_CHARS = 5_000_000;
+
+export function looksLikeRtf(text: string): boolean {
+	return text.trimStart().startsWith("{\\rtf");
+}
+
+interface CharState {
+	bold: boolean;
+	italic: boolean;
+	underline: boolean;
+	strike: boolean;
+	size: number;
+	color?: number;
+	background?: number;
+	font?: number;
+	script?: "super" | "sub";
+	caps?: "all" | "small";
+	hidden: boolean;
+}
+
+interface ParaState {
+	align?: RtfParagraph["align"];
+	indentLeft: number;
+	indentRight: number;
+	firstLine: number;
+	spaceBefore: number;
+	spaceAfter: number;
+	inTable: boolean;
+}
+
+type Dest = "body" | "skip" | "fonttbl" | "colortbl" | "pict" | "fldinst";
+
+interface GroupState {
+	char: CharState;
+	para: ParaState;
+	dest: Dest;
+	uc: number;
+}
+
+const SKIP_DESTINATIONS = new Set([
+	"stylesheet",
+	"info",
+	"listtable",
+	"listoverridetable",
+	"rsidtbl",
+	"generator",
+	"xmlnstbl",
+	"mmathPr",
+	"themedata",
+	"colorschememapping",
+	"datastore",
+	"latentstyles",
+	"header",
+	"footer",
+	"headerl",
+	"headerr",
+	"headerf",
+	"footerl",
+	"footerr",
+	"footerf",
+	"footnote",
+	"annotation",
+	"atnid",
+	"atnauthor",
+	"nonshppict",
+	"objdata",
+	"objclass",
+	"pgdsctbl",
+	"filetbl",
+	"revtbl",
+	"protusertbl",
+	"bkmkstart",
+	"bkmkend",
+	"xe",
+	"tc",
+	"txe",
+	"pnseclvl",
+	"template",
+	"userprops",
+	"docvar",
+	"wgrffmtfilter",
+	"pntxtb",
+	"pntxta",
+	"fldtype",
+	"defchp",
+	"defpap",
+	"panose",
+	"falt",
+	"fname",
+	"ftnsep",
+	"ftnsepc",
+	"aftnsep",
+	"aftnsepc",
+	"shpinst",
+	"sp",
+	"sn",
+	"sv",
+]);
+
+const SYMBOLS: Record<string, string> = {
+	bullet: "•",
+	endash: "–",
+	emdash: "—",
+	lquote: "‘",
+	rquote: "’",
+	ldblquote: "“",
+	rdblquote: "”",
+	tab: "\t",
+	emspace: " ",
+	enspace: " ",
+	qmspace: " ",
+	zwj: "‍",
+	zwnj: "‌",
+};
+
+function defaultChar(): CharState {
+	return { bold: false, italic: false, underline: false, strike: false, size: 12, hidden: false };
+}
+
+function defaultPara(): ParaState {
+	return { indentLeft: 0, indentRight: 0, firstLine: 0, spaceBefore: 0, spaceAfter: 0, inTable: false };
+}
+
+function decoderFor(codepage: number): TextDecoder {
+	const label =
+		codepage === 65001
+			? "utf-8"
+			: codepage === 932
+				? "shift_jis"
+				: codepage === 936
+					? "gbk"
+					: codepage === 949
+						? "euc-kr"
+						: codepage === 950
+							? "big5"
+							: `windows-${codepage}`;
+	try {
+		return new TextDecoder(label);
+	} catch {
+		return new TextDecoder("windows-1252");
+	}
+}
+
+const HEX = /^[0-9a-fA-F]$/;
+
+function hexToBase64(hex: string): string {
+	const clean = hex.replace(/[^0-9a-fA-F]/g, "");
+	let binary = "";
+	for (let i = 0; i + 1 < clean.length; i += 2)
+		binary += String.fromCharCode(Number.parseInt(clean.slice(i, i + 2), 16));
+	return btoa(binary);
+}
+
+export function parseRtf(
+	source: string,
+	maxBlocks = MAX_RTF_BLOCKS,
+	maxRuns = MAX_RTF_RUNS,
+	maxChars = MAX_RTF_CHARS,
+): RtfDocument {
+	if (!looksLikeRtf(source)) throw new Error("Not an RTF file");
+	const fonts = new Map<number, string>();
+	const colors: (string | undefined)[] = [];
+	let decoder = decoderFor(1252);
+	const blocks: RtfBlock[] = [];
+	let truncated = false;
+
+	const stack: GroupState[] = [];
+	let st: GroupState = { char: defaultChar(), para: defaultPara(), dest: "body", uc: 1 };
+
+	let runs: RtfRun[] = [];
+	let text = "";
+	let bytes: number[] = [];
+	// Table assembly
+	let tableRows: RtfParagraph[][][] = [];
+	let row: RtfParagraph[][] = [];
+	let cell: RtfParagraph[] = [];
+	// Font table and color table assembly
+	let fontNum: number | undefined;
+	let fontName = "";
+	let colorParts: { r?: number; g?: number; b?: number } = {};
+	let colorSeen = false;
+	// Picture assembly
+	let pict: { type?: string; hex: string; w?: number; h?: number; sx: number; sy: number } | undefined;
+	let skipChars = 0;
+	let runCount = 0;
+	let charCount = 0;
+	let defaultFont: number | undefined;
+
+	const flushBytes = () => {
+		if (bytes.length) {
